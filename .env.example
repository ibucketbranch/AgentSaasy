# .env.example
# Copy this file to .env and fill in your API keys. Never commit .env!

# Required - powers the agent's LLM reasoning via GPT-4o-mini
OPENAI_API_KEY=your-openai-key-here

# Optional - swap Claude in as the LLM for comparison or preference
# To use: change ChatOpenAI to ChatAnthropic in agent.py (see SETUP.md)
ANTHROPIC_API_KEY=your-anthropic-key-here
