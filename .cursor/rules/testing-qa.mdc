# Testing & Quality Assurance Rules

## Testing Philosophy

### Test Coverage Goals
- **Production code**: 100% coverage for tool functions
- **Agent orchestration**: Integration tests only (don't mock LLM in integration)
- **Data processing**: Unit tests for every calculation

### When to Write Tests
1. **BEFORE implementing** (TDD for complex logic)
2. **WITH the code** (standard practice)
3. **NEVER skip** (no untested code in main branch)

## Test File Structure

### Directory Layout
```
AgentSaaSy_EAM/
├── agent.py
├── tests/
│   ├── __init__.py
│   ├── test_agent.py          # Tool unit tests
│   ├── test_integration.py    # Integration tests
│   └── fixtures/
│       └── sample_data.csv    # Test data
```

### Test File Template
```python
"""Tests for [module_name].

Test Coverage:
- [Tool/function 1]: Unit tests for all paths
- [Tool/function 2]: Error handling
- [Integration]: End-to-end scenarios
"""

import pytest
import pandas as pd
from pathlib import Path
from unittest.mock import patch, MagicMock

# Import functions to test
from agent import (
    query_assets,
    analyze_asset_health,
    predict_failures,
    calculate_tco,
    track_compliance
)

# Constants
TEST_DATA_PATH = Path(__file__).parent / "fixtures" / "sample_data.csv"


class TestQueryAssets:
    """Test suite for query_assets tool."""
    
    def test_filter_by_asset_type(self):
        """Test filtering by asset type."""
        result = query_assets(asset_type="Pump")
        assert "Pump" in result
        assert "HVAC" not in result
    
    def test_filter_by_location(self):
        """Test filtering by location."""
        result = query_assets(location="Building A")
        assert "Building A" in result
    
    def test_error_handling_missing_file(self):
        """Test error handling when data file is missing."""
        with patch('agent.DATA_PATH', 'nonexistent.csv'):
            result = query_assets()
            assert "Error" in result
            assert "not found" in result.lower()
```

## Test Types

### 1. Unit Tests (Tool-Level)

Test each tool function in isolation:
```python
def test_analyze_asset_health_calculates_mean():
    """Verify mean health calculation."""
    result = analyze_asset_health(asset_type="Pump")
    
    # Parse JSON result
    data = json.loads(result)
    
    # Verify structure
    assert "mean_health" in data
    assert "at_risk_assets" in data
    
    # Verify calculations
    assert isinstance(data["mean_health"], float)
    assert 0 <= data["mean_health"] <= 100
```

### 2. Integration Tests (Agent-Level)

Test the full agent with real LLM calls:
```python
@pytest.mark.integration
def test_agent_handles_complex_query():
    """Test agent with multi-tool query."""
    query = """
    Find all critical pumps in Building A, 
    analyze their health trends, 
    and estimate repair costs.
    """
    
    response = agent.invoke({"input": query})
    
    # Verify response structure
    assert "output" in response
    assert len(response["output"]) > 0
    
    # Verify tool usage
    assert any("query_assets" in step for step in response["intermediate_steps"])
    assert any("analyze_asset_health" in step for step in response["intermediate_steps"])
```

### 3. Error Path Tests

Test all failure scenarios:
```python
def test_predict_failures_invalid_asset_type():
    """Test error handling for invalid asset type."""
    result = predict_failures(asset_type="InvalidType")
    assert "Error" in result or "not found" in result

def test_calculate_tco_missing_asset():
    """Test error handling for nonexistent asset."""
    result = calculate_tco(asset_id="NONEXISTENT-999")
    assert "Error" in result
    assert "not found" in result.lower()
```

### 4. Edge Case Tests

Test boundary conditions:
```python
def test_query_assets_min_health_boundary():
    """Test min_health at boundary values."""
    # Test 0 (minimum)
    result = query_assets(min_health=0)
    assert len(json.loads(result)) > 0
    
    # Test 100 (maximum)
    result = query_assets(min_health=100)
    # Should return only perfect assets or empty list
    
    # Test invalid (negative)
    result = query_assets(min_health=-1)
    assert "Error" in result

def test_predict_failures_empty_dataset():
    """Test prediction with no historical data."""
    with patch('agent.load_asset_data') as mock_load:
        mock_load.return_value = pd.DataFrame()  # Empty
        result = predict_failures()
        assert "Error" in result or "no data" in result.lower()
```

## Pytest Best Practices

### Fixtures for Reusable Data
```python
@pytest.fixture
def sample_asset_data():
    """Provide sample asset data for tests."""
    return pd.DataFrame({
        'asset_id': ['PUMP-001', 'HVAC-002'],
        'asset_type': ['Pump', 'HVAC'],
        'health_score': [45, 80],
        'location': ['Building A', 'Building B']
    })

def test_with_fixture(sample_asset_data):
    """Use fixture in test."""
    assert len(sample_asset_data) == 2
```

### Parametrize for Multiple Cases
```python
@pytest.mark.parametrize("asset_type,expected_count", [
    ("Pump", 10),
    ("HVAC", 8),
    ("Conveyor", 12),
])
def test_query_assets_by_type(asset_type, expected_count):
    """Test filtering by various asset types."""
    result = query_assets(asset_type=asset_type)
    data = json.loads(result)
    assert len(data) == expected_count
```

### Skip Tests Conditionally
```python
@pytest.mark.skipif(
    os.getenv("OPENAI_API_KEY") is None,
    reason="Requires OPENAI_API_KEY"
)
def test_agent_with_real_llm():
    """Integration test with real LLM."""
    pass
```

### Mark Test Categories
```python
@pytest.mark.unit
def test_unit_level():
    pass

@pytest.mark.integration
def test_integration_level():
    pass

@pytest.mark.slow
def test_expensive_operation():
    pass
```

Run specific marks:
```bash
pytest -m unit           # Only unit tests
pytest -m "not slow"     # Skip slow tests
pytest -m integration    # Only integration tests
```

## Mocking External Dependencies

### Mock OpenAI LLM Calls
```python
from unittest.mock import patch, MagicMock
from langchain.schema import AIMessage

@patch('langchain_openai.ChatOpenAI')
def test_agent_without_api_call(mock_llm_class):
    """Test agent logic without real LLM."""
    # Setup mock
    mock_llm = MagicMock()
    mock_llm.invoke.return_value = AIMessage(
        content="Query complete. Found 5 critical assets."
    )
    mock_llm_class.return_value = mock_llm
    
    # Test
    response = agent.invoke({"input": "Find critical assets"})
    assert "critical" in response["output"]
```

### Mock File I/O
```python
@patch('agent.pd.read_csv')
def test_with_mock_data(mock_read_csv):
    """Test with mocked data loading."""
    mock_df = pd.DataFrame({
        'asset_id': ['TEST-001'],
        'health_score': [30]
    })
    mock_read_csv.return_value = mock_df
    
    result = query_assets()
    assert "TEST-001" in result
```

## Assertion Strategies

### String Content Assertions
```python
# Check for key phrases
assert "Critical" in result
assert "Building A" in result

# Check JSON structure
data = json.loads(result)
assert "asset_id" in data[0]
assert isinstance(data, list)
```

### Numeric Assertions
```python
# Exact equality
assert health_score == 75

# Approximate equality (for floats)
import pytest
assert pytest.approx(risk_score, abs=0.01) == 85.67

# Range checks
assert 0 <= health_score <= 100
```

### Exception Assertions
```python
def test_raises_value_error():
    """Test that invalid input raises ValueError."""
    with pytest.raises(ValueError, match="Health score must be 0-100"):
        calculate_risk_score(health_score=150)
```

